# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# Deliberately-vulnerable demo fixtures. They contain fake-but-format-valid
# credentials so the scanner can be tested against them, which is exactly the
# kind of thing that should never live in a public repo. Kept local only;
# `npm run fixture` and `npm run audit:demo` still work on your machine.
fixtures/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
